# ERPNext connection -- shared service account used for calls made with
# no per-user identity bound (system/internal calls). Any one of the
# three prefixes below works (multi-var fallback in ERP/erp_client.py).
ERP_URL=https://your-site.erpnext.com
ERP_API_KEY=your_service_account_api_key
ERP_API_SECRET=your_service_account_api_secret

# ERPNEXT_URL=...
# ERPNEXT_API_KEY=...
# ERPNEXT_API_SECRET=...
# FRAPPE_URL=...
# FRAPPE_API_KEY=...
# FRAPPE_API_SECRET=...

# LLM
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Public-web Lead research (https://serper.dev)
SERPER_API_KEY=
SERPER_SEARCH_URL=https://google.serper.dev/search
SERPER_TIMEOUT_SECONDS=15
LLM_MODEL=gpt-4o-mini
TTS_VOICE=af_heart
TOOL_RAG_TOP_K=3
TOOL_RAG_MIN_SCORE=0.25
PORT=8005

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=magma-assistance

# Postgres (audit log)
PGHOST=localhost
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
