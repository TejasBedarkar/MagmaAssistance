# ERPNext connection -- shared service account used for calls made with
# no per-user identity bound (system/internal calls). Any one of the
# three prefixes below works (multi-var fallback in ERP/erp_client.py).
ERP_URL=https://your-site.erpnext.com
ERP_API_KEY=your_service_account_api_key
ERP_API_SECRET=your_service_account_api_secret

# ERPNEXT_URL=...
# ERPNEXT_API_KEY=...
# ERPNEXT_API_SECRET=...
# FRAPPE_URL=...
# FRAPPE_API_KEY=...
# FRAPPE_API_SECRET=...

# Host header to send on ERP requests. Only needed when ERP_URL points at
# an IP / tunnel and the Frappe bench resolves the site by Host (local
# multi-site benches). Leave unset for a normal single-domain deployment.
# FRAPPE_SITE_NAME=magnaerp.local

# CORS Configuration:
# IMPORTANT FOR PRODUCTION:
# In local development, the frontend typically connects from http://127.0.0.1:8001 or http://magna.local:8001.
# In production deployments, you MUST set ALLOWED_ORIGINS to the exact comma-separated list
# of allowed domains (e.g. https://erp.yourcompany.com,https://assistant.yourcompany.com).
# When set to specific origins (non-*), ALLOW_CREDENTIALS is automatically enabled so the browser
# can safely transmit session cookies and credentials. If unset, defaults to "*" without credentials.
# ALLOWED_ORIGINS=https://magnaerp.tjdem.online,https://ai.tjdem.online

# LLM
OPENROUTER_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Web Search & Lead Enrichment
# Apollo.io is the primary B2B lead enrichment provider (direct emails, phones, address).
# Get your API key from Apollo.io -> Settings -> Integrations -> API Keys
APOLLO_API_KEY=

# Tavily is the primary search engine for web crawling (AI-optimized, designed for LLM agents).
# Get a free key at https://app.tavily.com (1000 searches/month free).
# If not set, the system falls back to the local SearXNG Docker container.
TAVILY_API_KEY=
# Override the SearXNG URL if you run it on a different port or host.
SEARXNG_URL=http://localhost:8080


# Read Aloud TTS (TTS/TTS.py, TTS/STT.py). Live Voice uses the browser's Web Speech API.
#
# TTS_VOICE must be one of: alloy, ash, ballad, coral, echo, fable,
# onyx, nova, sage, shimmer, verse.
TTS_VOICE=alloy
# OPENAI_TTS_MODEL: read by TTS/TTS.py for /api/tts (Read Aloud).
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# TTS_ACCENT_INSTRUCTIONS: optional speaking-style/accent steering, empty by default.
# Only takes effect on gpt-4o-mini-tts (not tts-1/tts-1-hd).
TTS_ACCENT_INSTRUCTIONS=
# WHISPER_MODEL: used by TTS/STT.py's one-shot file transcription.
WHISPER_MODEL=gpt-4o-mini-transcribe

TOOL_RAG_TOP_K=3
TOOL_RAG_MIN_SCORE=0.25
PORT=8005

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=magma-assistance