# ERPNext connection -- shared service account used for calls made with
# no per-user identity bound (system/internal calls). Any one of the
# three prefixes below works (multi-var fallback in ERP/erp_client.py).
ERP_URL=https://your-site.erpnext.com
ERP_API_KEY=your_service_account_api_key
ERP_API_SECRET=your_service_account_api_secret

# ERPNEXT_URL=...
# ERPNEXT_API_KEY=...
# ERPNEXT_API_SECRET=...
# FRAPPE_URL=...
# FRAPPE_API_KEY=...
# FRAPPE_API_SECRET=...

# LLM
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Company discovery (optional). When set, legal Indian companies are first
# identified through MCA master data published on data.gov.in.
# Create a free key at https://data.gov.in/ and use Profile -> API Key.
DATA_GOV_IN_API_KEY=
# Enables Google Places Text Search to discover the selected company's public
# website. Requires Google Maps Platform billing and Places API (New).
GOOGLE_MAPS_API_KEY=

# Voice (TTS/TTS.py + TTS/STT.py) -- both use OpenAI's hosted audio
# models via OPENAI_API_KEY above; no separate key needed.
# TTS_VOICE must be one of: alloy, ash, ballad, coral, echo, fable,
# onyx, nova, sage, shimmer, verse.
TTS_VOICE=alloy
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# WHISPER_MODEL names an OpenAI transcription model (not a local
# Whisper checkpoint) -- "gpt-4o-mini-transcribe" or "whisper-1".
WHISPER_MODEL=gpt-4o-mini-transcribe

# Realtime voice (/ws/voice, Voice/realtime_stt.py) -- proxies OpenAI's
# Realtime API in transcription-only mode for streaming STT + server VAD.
# Bills per connected second, not per turn -- keep this in mind before
# leaving a session open idle.
REALTIME_STT_MODEL=gpt-4o-mini-transcribe
# Used by magma_voice.py to find the backend; not read by the server.
MAGMA_WS_URL=ws://localhost:8050/ws/voice
MAGMA_SESSION_ID=voice-cli

TOOL_RAG_TOP_K=3
TOOL_RAG_MIN_SCORE=0.25
PORT=8005

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=magma-assistance

# Postgres (audit log)
PGHOST=localhost
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
