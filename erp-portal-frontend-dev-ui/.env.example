# Dev: Vite proxies /api to bench (see sites/common_site_config.json → webserver_port).
VITE_PROXY_TARGET=http://127.0.0.1:8000
# Site name folder under sites/ (required for correct DB when using proxy).
VITE_FRAPPE_SITE=magnaerp.local

# Production build: browser calls this origin for /api (same host recommended, e.g. https://your-site.com)
# VITE_SITE_ORIGIN=https://magnaerp.local
